SCAN_DIR="/home/kali/Desktop/pt" python - <<'PY'
import os
import json
import subprocess
from pathlib import Path

from cve_bin_tool.version_scanner import VersionScanner
from cve_bin_tool.strings import parse_strings

ROOT = Path(os.environ["SCAN_DIR"])
OUTPUT = Path("cve-bin-components.json")

if not ROOT.exists():
    raise SystemExit(f"[ERROR] Directory does not exist: {ROOT}")

# Загружаем штатные checkers CVE Binary Tool.
# Никакой CVE database здесь не создаётся.
checkers = VersionScanner.load_checkers()

print(f"[INFO] Scan root: {ROOT}")
print(f"[INFO] Loaded checkers: {len(checkers)}")
print()

found = {}
scanned = 0
skipped = 0


def is_native_binary(path: Path) -> bool:
    try:
        result = subprocess.run(
            ["file", "-b", str(path)],
            capture_output=True,
            text=True,
            timeout=10,
        )

        info = result.stdout

        return any(x in info for x in (
            "ELF",
            "PE32 executable",
            "PE32+ executable",
            "Mach-O",
            "WebAssembly",
        ))

    except Exception:
        return False


for path in ROOT.rglob("*"):

    if not path.is_file() or path.is_symlink():
        continue

    if not is_native_binary(path):
        skipped += 1
        continue

    scanned += 1

    print(f"[SCAN {scanned}] {path}")

    try:
        lines = parse_strings(str(path))
    except Exception as e:
        print(f"  [WARN] strings failed: {e}")
        continue

    for checker_name, checker_class in checkers.items():

        try:
            checker = checker_class()

            version_results = checker.get_versions(
                lines,
                str(path),
            )

        except Exception:
            # Один сломавшийся checker не должен останавливать весь scan.
            continue

        if not (
            version_results.matched_filename
            or version_results.matched_contains
        ):
            continue

        for version in version_results.versions:

            if not version or version == "UNKNOWN":
                continue

            for vendor, product in checker.VENDOR_PRODUCT:

                key = (
                    vendor,
                    product,
                    version,
                    str(path),
                )

                found[key] = {
                    "vendor": vendor,
                    "product": product,
                    "version": version,
                    "path": str(path),
                    "checker": checker_name,
                    "matched_filename":
                        bool(version_results.matched_filename),
                    "matched_contains":
                        bool(version_results.matched_contains),
                }

                print(
                    f"    [+] {vendor}/{product} "
                    f"{version} "
                    f"[{checker_name}]"
                )


components = sorted(
    found.values(),
    key=lambda x: (
        x["product"].lower(),
        x["version"],
        x["path"],
    ),
)


print()
print("=" * 120)
print(
    f"{'VENDOR':20} "
    f"{'PRODUCT':30} "
    f"{'VERSION':18} "
    f"{'CHECKER':22} "
    f"PATH"
)
print("=" * 120)

for item in components:
    print(
        f'{item["vendor"][:20]:20} '
        f'{item["product"][:30]:30} '
        f'{item["version"][:18]:18} '
        f'{item["checker"][:22]:22} '
        f'{item["path"]}'
    )


OUTPUT.write_text(
    json.dumps(
        {
            "scanner": "cve-bin-tool checkers",
            "mode": "component-detection-only",
            "scan_root": str(ROOT),
            "scanned_binaries": scanned,
            "components": components,
        },
        indent=2,
        ensure_ascii=False,
    ),
    encoding="utf-8",
)


print()
print("=" * 120)
print(f"[DONE] Native binaries scanned : {scanned}")
print(f"[DONE] Other files skipped      : {skipped}")
print(f"[DONE] Component findings       : {len(components)}")
print(f"[DONE] JSON                     : {OUTPUT.resolve()}")
print("=" * 120)
PY
