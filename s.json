find /home/kali/Desktop/pt_binaries -type f -print0 |
while IFS= read -r -d '' f; do

    TYPE="$(file -b "$f" 2>/dev/null || true)"

    case "$TYPE" in
        ELF*|PE32*|PE32+*|Mach-O*)
            echo
            echo "================================================================================"
            echo "FILE: $f"
            echo "TYPE: $TYPE"
            echo "--------------------------------------------------------------------------------"
            diec "$f"
            echo "================================================================================"
            ;;
    esac

done | tee die-results.txt
