#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# BLint + local blint-db installer
#
# Creates:
#   ~/blint-venv/
#   ~/blint-db/
#   ~/blint-db/blint.db
#   ~/blint-db/blint.metadata.json
#   ~/blint-db/activate-blintdb.sh
#
# Default database:
#   zlib
#   bzip2
#
# Usage:
#
#   chmod +x install_blintdb.sh
#   ./install_blintdb.sh
#
# Or specify Meson projects:
#
#   ./install_blintdb.sh zlib bzip2
#
# ============================================================


# ------------------------------------------------------------
# Error handling + keep console open
# ------------------------------------------------------------

LAST_ERROR=""

on_error() {
    local exit_code=$?
    local line="${1:-unknown}"
    local command="${2:-unknown}"

    LAST_ERROR="
ERROR
Line:      $line
Command:   $command
Exit code: $exit_code
"

    return "$exit_code"
}


pause_on_exit() {
    local exit_code=$?

    echo
    echo "============================================================"

    if [[ "$exit_code" -eq 0 ]]; then

        echo " BLint DB installation finished successfully."

    else

        echo " BLint DB installation FAILED."

        if [[ -n "$LAST_ERROR" ]]; then
            echo "$LAST_ERROR"
        fi

    fi

    echo "============================================================"
    echo

    # Use the controlling terminal if available.
    # This also works better when the script was started
    # by double-clicking / launching from another program.
    if [[ -r /dev/tty && -w /dev/tty ]]; then
        read -r -p "Press ENTER to close..." </dev/tty || true
    elif [[ -t 0 ]]; then
        read -r -p "Press ENTER to close..." || true
    fi
}


trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR
trap pause_on_exit EXIT


# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

BLINT_DB_DIR="${BLINT_DB_DIR:-$HOME/blint-db}"
VENV_DIR="${VENV_DIR:-$HOME/blint-venv}"

PROJECTS=("$@")

if [[ ${#PROJECTS[@]} -eq 0 ]]; then
    PROJECTS=(
        zlib
        bzip2
    )
fi


echo
echo "============================================================"
echo " BLint + local blint-db installer"
echo "============================================================"
echo

echo "[INFO] User:"
echo "       $(whoami)"

echo
echo "[INFO] Home:"
echo "       $HOME"

echo
echo "[INFO] Virtual environment:"
echo "       $VENV_DIR"

echo
echo "[INFO] blint-db repository:"
echo "       $BLINT_DB_DIR"

echo
echo "[INFO] Projects:"
printf '       - %s\n' "${PROJECTS[@]}"

echo


# ------------------------------------------------------------
# 1. Install system dependencies
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[1/8] Installing system dependencies"
echo "============================================================"
echo

sudo apt update

sudo apt install -y \
    git \
    curl \
    ca-certificates \
    python3 \
    python3-dev \
    python3-venv \
    python3-pip \
    build-essential \
    cmake \
    pkg-config \
    ninja-build \
    llvm \
    llvm-dev \
    clang \
    libffi-dev \
    zlib1g-dev \
    libzstd-dev \
    jq \
    file


# ------------------------------------------------------------
# 2. Find LLVM
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[2/8] Detecting LLVM"
echo "============================================================"
echo


LLVM_CONFIG="$(command -v llvm-config || true)"

if [[ -z "$LLVM_CONFIG" ]]; then

    echo "[ERROR] llvm-config was not found in PATH."
    echo
    echo "Installed LLVM packages:"
    dpkg -l | grep -E 'llvm|clang' || true

    exit 1
fi


LLVM_PREFIX="$("$LLVM_CONFIG" --prefix)"

if [[ -z "$LLVM_PREFIX" ]]; then
    echo "[ERROR] Could not determine LLVM prefix."
    exit 1
fi


LLVM_VERSION="$("$LLVM_CONFIG" --version)"


echo "[INFO] llvm-config:"
echo "       $LLVM_CONFIG"

echo
echo "[INFO] LLVM version:"
echo "       $LLVM_VERSION"

echo
echo "[INFO] LLVM prefix:"
echo "       $LLVM_PREFIX"


export NYXSTONE_LLVM_PREFIX="$LLVM_PREFIX"
export PATH="$LLVM_PREFIX/bin:$PATH"


# Prefer clang from this LLVM installation if available.

if [[ -x "$LLVM_PREFIX/bin/clang" ]]; then
    export CC="$LLVM_PREFIX/bin/clang"
else
    export CC="$(command -v clang)"
fi


if [[ -x "$LLVM_PREFIX/bin/clang++" ]]; then
    export CXX="$LLVM_PREFIX/bin/clang++"
else
    export CXX="$(command -v clang++)"
fi


echo
echo "[INFO] CC:"
echo "       $CC"

echo
echo "[INFO] CXX:"
echo "       $CXX"


# ------------------------------------------------------------
# 3. Create Python virtual environment
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[3/8] Creating Python virtual environment"
echo "============================================================"
echo


if [[ ! -d "$VENV_DIR" ]]; then

    echo "[INFO] Creating:"
    echo "       $VENV_DIR"

    python3 -m venv "$VENV_DIR"

else

    echo "[INFO] Existing venv found:"
    echo "       $VENV_DIR"

fi


# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"


echo
echo "[INFO] Python:"
python --version

echo
echo "[INFO] Python executable:"
which python


python -m pip install --upgrade \
    pip \
    setuptools \
    wheel


# ------------------------------------------------------------
# 4. Install BLint
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[4/8] Installing BLint"
echo "============================================================"
echo


python -m pip install -U 'blint[extended]'


echo
echo "[INFO] Installed BLint:"
python -m pip show blint | grep -E '^(Name|Version|Location):' || true


# ------------------------------------------------------------
# 5. Clone or update blint-db
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[5/8] Preparing blint-db repository"
echo "============================================================"
echo


if [[ -d "$BLINT_DB_DIR/.git" ]]; then

    echo "[INFO] blint-db already cloned."
    echo "[INFO] Updating repository..."

    git -C "$BLINT_DB_DIR" fetch --all --prune

    # Do not destroy local modifications.
    if git -C "$BLINT_DB_DIR" diff --quiet &&
       git -C "$BLINT_DB_DIR" diff --cached --quiet; then

        git -C "$BLINT_DB_DIR" pull --ff-only || true

    else

        echo "[WARN] Local changes detected."
        echo "[WARN] Repository will NOT be automatically updated."

    fi

else

    if [[ -e "$BLINT_DB_DIR" ]]; then

        echo "[ERROR] Path already exists but is not a Git repository:"
        echo "        $BLINT_DB_DIR"
        echo
        echo "Rename/remove it or set another BLINT_DB_DIR."

        exit 1
    fi


    git clone \
        https://github.com/AppThreat/blint-db.git \
        "$BLINT_DB_DIR"

fi


# ------------------------------------------------------------
# 6. Install blint-db + Nyxstone
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[6/8] Installing blint-db"
echo "============================================================"
echo


cd "$BLINT_DB_DIR"


export NYXSTONE_LLVM_PREFIX="$LLVM_PREFIX"
export PATH="$LLVM_PREFIX/bin:$PATH"


echo "[INFO] NYXSTONE_LLVM_PREFIX:"
echo "       $NYXSTONE_LLVM_PREFIX"

echo
echo "[INFO] llvm-config:"
command -v llvm-config

echo
echo "[INFO] LLVM:"
llvm-config --version


python -m pip install -e '.[extended]'


if ! command -v blint-db >/dev/null 2>&1; then

    echo
    echo "[ERROR] blint-db executable was not installed."
    echo

    exit 1
fi


echo
echo "[INFO] blint-db executable:"
command -v blint-db


echo
echo "[INFO] blint-db help check:"
blint-db --help >/dev/null

echo "[OK] blint-db CLI works."


# ------------------------------------------------------------
# 7. Build database
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[7/8] Building local BLint database"
echo "============================================================"
echo


cd "$BLINT_DB_DIR"


# Keep symbols in generated binaries.
export BLINT_DB_MESON_STRIP=0


echo "[INFO] Building database:"
echo "       $BLINT_DB_DIR/blint.db"

echo
echo "[INFO] Selected projects:"
printf '       - %s\n' "${PROJECTS[@]}"

echo
echo "[INFO] Disassembly/function fingerprints: ENABLED"
echo


# Clean stale SQLite sidecar files.

rm -f \
    "$BLINT_DB_DIR/blint.db-wal" \
    "$BLINT_DB_DIR/blint.db-shm"


blint-db \
    --db-file "$BLINT_DB_DIR/blint.db" \
    --clean-start \
    --disassemble \
    build-meson \
    -s "${PROJECTS[@]}"


# ------------------------------------------------------------
# 8. Verification + activation helper
# ------------------------------------------------------------

echo
echo "============================================================"
echo "[8/8] Verifying database"
echo "============================================================"
echo


if [[ ! -s "$BLINT_DB_DIR/blint.db" ]]; then

    echo "[ERROR] blint.db was not created."
    exit 1

fi


echo "[OK] Database exists:"
ls -lh "$BLINT_DB_DIR/blint.db"


if [[ -f "$BLINT_DB_DIR/blint.metadata.json" ]]; then

    echo
    echo "[OK] Metadata exists:"
    ls -lh "$BLINT_DB_DIR/blint.metadata.json"

fi


# ------------------------------------------------------------
# Create activation script
# ------------------------------------------------------------

ACTIVATE_FILE="$BLINT_DB_DIR/activate-blintdb.sh"


cat > "$ACTIVATE_FILE" <<EOF
#!/usr/bin/env bash

source "$VENV_DIR/bin/activate"

export BLINTDB_HOME="$BLINT_DB_DIR"

export NYXSTONE_LLVM_PREFIX="$LLVM_PREFIX"

export PATH="$LLVM_PREFIX/bin:\$PATH"

export BLINT_DB_MESON_STRIP=0

echo
echo "BLint environment activated."
echo
echo "BLINTDB_HOME:"
echo "  \$BLINTDB_HOME"
echo
echo "Database:"
echo "  \$BLINTDB_HOME/blint.db"
echo
echo "Python:"
which python
echo
echo "BLint:"
which blint
echo
echo "blint-db:"
which blint-db
echo
EOF


chmod +x "$ACTIVATE_FILE"


# ------------------------------------------------------------
# Verify BLint sees local DB
# ------------------------------------------------------------

export BLINTDB_HOME="$BLINT_DB_DIR"


echo
echo "[INFO] Checking BLint configuration..."
echo


python - <<'PY'
from blint.config import BLINTDB_LOC

print("BLINTDB_LOC =", BLINTDB_LOC)
PY


# ------------------------------------------------------------
# Final information
# ------------------------------------------------------------

echo
echo
echo "############################################################"
echo "#                                                          #"
echo "#                 INSTALLATION COMPLETE                    #"
echo "#                                                          #"
echo "############################################################"
echo


echo "Local database:"
echo
echo "  $BLINT_DB_DIR/blint.db"

echo
echo "Activation script:"
echo
echo "  source \"$ACTIVATE_FILE\""

echo
echo "Projects in this build:"
printf '  - %s\n' "${PROJECTS[@]}"


echo
echo "------------------------------------------------------------"
echo "To use BLint later"
echo "------------------------------------------------------------"
echo

echo "source \"$ACTIVATE_FILE\""


echo
echo "------------------------------------------------------------"
echo "Scan ONE binary"
echo "------------------------------------------------------------"
echo

cat <<EOF
blint sbom \\
    -i /path/to/binary \\
    -o /tmp/blint-result.cdx.json \\
    --use-blintdb \\
    --deep
EOF


echo
echo "------------------------------------------------------------"
echo "Scan a DIRECTORY"
echo "------------------------------------------------------------"
echo

cat <<EOF
blint sbom \\
    -i /path/to/unpacked/product \\
    -o /tmp/blint-result.cdx.json \\
    --use-blintdb \\
    --deep
EOF


echo
echo "------------------------------------------------------------"
echo "Show detected components"
echo "------------------------------------------------------------"
echo

cat <<'EOF'
jq -r '
.components[] |
[
    .name,
    (.version // "-"),
    (.purl // "-")
] |
@tsv
' /tmp/blint-result.cdx.json
EOF


echo
echo "------------------------------------------------------------"
echo "IMPORTANT"
echo "------------------------------------------------------------"
echo
echo "Do NOT run:"
echo
echo "  blint db --download"
echo
echo "This installation uses your LOCAL blint.db."
echo
