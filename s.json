#!/usr/bin/env bash

set -Eeuo pipefail

# ============================================================
# BLint DB local installer
#
# Creates:
#   ~/blint-db/blint.db
#   ~/blint-db/blint.metadata.json
#
# Usage:
#   chmod +x install_blintdb.sh
#   ./install_blintdb.sh
#
# Optional custom projects:
#   ./install_blintdb.sh zlib bzip2
# ============================================================

BLINT_DB_DIR="${BLINT_DB_DIR:-$HOME/blint-db}"
VENV_DIR="${VENV_DIR:-$HOME/blint-venv}"

# Minimal test corpus.
# Can be overridden by arguments:
#   ./install_blintdb.sh zlib bzip2 ...
PROJECTS=("$@")

if [[ ${#PROJECTS[@]} -eq 0 ]]; then
    PROJECTS=(
        zlib
        bzip2
    )
fi

echo "============================================================"
echo " BLint DB local installer"
echo "============================================================"
echo
echo "[INFO] BLint DB dir : $BLINT_DB_DIR"
echo "[INFO] Python venv  : $VENV_DIR"
echo "[INFO] Projects     : ${PROJECTS[*]}"
echo

# ------------------------------------------------------------
# 1. System dependencies
# ------------------------------------------------------------

echo "[1/7] Installing system dependencies..."

sudo apt update

sudo apt install -y \
    git \
    python3 \
    python3-venv \
    python3-pip \
    build-essential \
    cmake \
    pkg-config \
    ninja-build \
    llvm-19 \
    llvm-19-dev \
    clang-19 \
    libffi-dev \
    zlib1g-dev \
    libzstd-dev \
    jq \
    file

# ------------------------------------------------------------
# 2. LLVM / Nyxstone environment
# ------------------------------------------------------------

echo
echo "[2/7] Configuring LLVM..."

LLVM_PREFIX="/usr/lib/llvm-19"

if [[ ! -x "$LLVM_PREFIX/bin/llvm-config" ]]; then
    echo "[ERROR] llvm-config not found:"
    echo "        $LLVM_PREFIX/bin/llvm-config"
    exit 1
fi

export NYXSTONE_LLVM_PREFIX="$LLVM_PREFIX"
export PATH="$LLVM_PREFIX/bin:$PATH"
export CC="$LLVM_PREFIX/bin/clang"
export CXX="$LLVM_PREFIX/bin/clang++"

echo "[INFO] LLVM: $(llvm-config --version)"
echo "[INFO] llvm-config: $(command -v llvm-config)"

# ------------------------------------------------------------
# 3. Python virtual environment
# ------------------------------------------------------------

echo
echo "[3/7] Creating Python virtual environment..."

if [[ ! -d "$VENV_DIR" ]]; then
    python3 -m venv "$VENV_DIR"
fi

# shellcheck disable=SC1091
source "$VENV_DIR/bin/activate"

python -m pip install --upgrade \
    pip \
    setuptools \
    wheel

# ------------------------------------------------------------
# 4. Install BLint
# ------------------------------------------------------------

echo
echo "[4/7] Installing BLint..."

python -m pip install -U 'blint[extended]'

echo "[INFO] BLint installed:"
pip show blint | grep -E '^(Name|Version):'

# ------------------------------------------------------------
# 5. Clone/update blint-db
# ------------------------------------------------------------

echo
echo "[5/7] Installing blint-db..."

if [[ -d "$BLINT_DB_DIR/.git" ]]; then

    echo "[INFO] Existing repository found. Updating..."

    git -C "$BLINT_DB_DIR" fetch --all --prune
    git -C "$BLINT_DB_DIR" pull --ff-only

else

    if [[ -e "$BLINT_DB_DIR" ]]; then
        echo "[ERROR] $BLINT_DB_DIR exists but is not a git repository."
        exit 1
    fi

    git clone \
        https://github.com/AppThreat/blint-db.git \
        "$BLINT_DB_DIR"
fi

cd "$BLINT_DB_DIR"

# Needed while compiling nyxstone.
export NYXSTONE_LLVM_PREFIX="$LLVM_PREFIX"
export PATH="$LLVM_PREFIX/bin:$PATH"

python -m pip install -e '.[extended]'

if ! command -v blint-db >/dev/null 2>&1; then
    echo "[ERROR] blint-db executable not found after installation."
    exit 1
fi

echo "[INFO] blint-db installed:"
command -v blint-db

# ------------------------------------------------------------
# 6. Build local DB
# ------------------------------------------------------------

echo
echo "[6/7] Building local BLint database..."
echo
echo "[INFO] Selected projects:"
printf '       - %s\n' "${PROJECTS[@]}"
echo

cd "$BLINT_DB_DIR"

# Preserve symbols. They are useful as evidence in addition
# to function fingerprints.
export BLINT_DB_MESON_STRIP=0

rm -f \
    "$BLINT_DB_DIR/blint.db" \
    "$BLINT_DB_DIR/blint.db-wal" \
    "$BLINT_DB_DIR/blint.db-shm"

blint-db \
    --db-file "$BLINT_DB_DIR/blint.db" \
    --clean-start \
    --disassemble \
    build-meson \
    -s "${PROJECTS[@]}"

# ------------------------------------------------------------
# 7. Verify and create env helper
# ------------------------------------------------------------

echo
echo "[7/7] Verifying database..."

if [[ ! -s "$BLINT_DB_DIR/blint.db" ]]; then
    echo "[ERROR] Database was not created."
    exit 1
fi

cat > "$BLINT_DB_DIR/activate-blintdb.sh" <<EOF
#!/usr/bin/env bash

export BLINTDB_HOME="$BLINT_DB_DIR"
export NYXSTONE_LLVM_PREFIX="$LLVM_PREFIX"
export PATH="$LLVM_PREFIX/bin:\$PATH"

source "$VENV_DIR/bin/activate"

echo "BLINTDB_HOME=\$BLINTDB_HOME"
echo "BLint DB: \$BLINTDB_HOME/blint.db"
EOF

chmod +x "$BLINT_DB_DIR/activate-blintdb.sh"

echo
echo "============================================================"
echo " Installation complete"
echo "============================================================"
echo

ls -lh "$BLINT_DB_DIR/blint.db"

if [[ -f "$BLINT_DB_DIR/blint.metadata.json" ]]; then
    ls -lh "$BLINT_DB_DIR/blint.metadata.json"
fi

echo
echo "Activate environment with:"
echo
echo "  source \"$BLINT_DB_DIR/activate-blintdb.sh\""
echo
echo "Then check:"
echo
echo "  python - <<'PY'"
echo "  from blint.config import BLINTDB_LOC"
echo "  print(BLINTDB_LOC)"
echo "  PY"
echo
echo "Expected:"
echo
echo "  $BLINT_DB_DIR/blint.db"
echo
echo "Example scan:"
echo
echo "  blint sbom \\"
echo "      -i /path/to/binaries \\"
echo "      -o /tmp/blint-result.cdx.json \\"
echo "      --use-blintdb \\"
echo "      --deep"
echo
