SRC="/home/kali/product"
DST="/home/kali/product_binaries"

rm -rf "$DST"
mkdir -p "$DST"

find "$SRC" -type f -print0 |
while IFS= read -r -d '' f; do

    type="$(file -b "$f" 2>/dev/null || true)"

    case "$type" in
        ELF*|PE32*|PE32+*|Mach-O*|WebAssembly*)
            rel="${f#$SRC/}"
            mkdir -p "$DST/$(dirname "$rel")"
            cp -a "$f" "$DST/$rel"
            echo "[BINARY] $rel"
            ;;
    esac

done

echo
echo "Binary files:"
find "$DST" -type f | wc -l
