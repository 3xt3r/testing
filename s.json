DIR="."

find "$DIR" -type f -print0 |
while IFS= read -r -d '' BIN; do

    TYPE="$(file -b "$BIN" 2>/dev/null || true)"
    [[ "$TYPE" == ELF* ]] || continue

    echo
    echo "================================================================================"
    echo "FILE: $BIN"
    echo "================================================================================"

    echo
    echo "=== TYPE ==="
    echo "$TYPE"

    echo
    echo "=== COMPILER ==="
    readelf -p .comment "$BIN" 2>/dev/null || echo "No .comment"

    echo
    echo "=== GCC FLAGS ==="
    readelf -p .GCC.command.line "$BIN" 2>/dev/null || echo "No recorded flags"

    echo
    echo "=== DEBUG / SYMBOLS ==="
    readelf -S "$BIN" 2>/dev/null |
        grep -Ei '\.debug_|\.zdebug_|\.symtab|\.dynsym|\.comment|GCC\.command' \
        || echo "No debug/symbol sections"

    echo
    echo "=== DEPENDENCIES ==="
    readelf -d "$BIN" 2>/dev/null |
        grep NEEDED \
        || echo "No DT_NEEDED"

    echo
    echo "=== DWARF ==="
    readelf --debug-dump=info "$BIN" 2>/dev/null |
        grep -m10 -E 'DW_AT_producer|DW_AT_language|DW_AT_comp_dir' \
        || echo "No DWARF"

    echo
    echo "=== CHECKSEC ==="
    checksec --file="$BIN" 2>/dev/null || echo "checksec failed/not available"

done | tee "$DIR/binary-analysis.txt"
